# Example environment variables for legal_rag_engine
# Do NOT commit secrets. Use environment variables or a secret manager.

# Runtime
RUNTIME_DEVICE=auto
RUNTIME_GPU_ID=0
RUNTIME_PRECISION=auto

# Retrieval
DENSE_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
FAISS_INDEX_PATH=artifacts_portable/faiss.index
EMBEDDINGS_CACHE=artifacts_portable/embeddings.json

# LLM
LLM_BACKEND=qwen_transformers
QWEN_OFFLOAD_DIR=artifacts/qwen_offload

# App
ARTIFACT_DIR=artifacts_portable
LOG_LEVEL=INFO
API_KEY=demo-key
LEGAL_API_URL=http://localhost:8000/v1/query

# DVC / remote
DVC_REMOTE_URL=../legal-rag-remote

# Monitoring
PROMETHEUS_ENABLED=false
OTEL_COLLECTOR_URL=
