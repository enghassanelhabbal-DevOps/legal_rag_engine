# Example environment variables for legal_rag_engine
# Do NOT commit secrets. Use environment variables or a secret manager.

# Runtime
RUNTIME_DEVICE=auto
RUNTIME_GPU_ID=0
RUNTIME_PRECISION=auto

# Retrieval
DENSE_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
FAISS_INDEX_PATH=artifacts_portable/faiss.index
EMBEDDINGS_CACHE=artifacts_portable/embeddings.json

# LLM
LLM_BACKEND=qwen_transformers
QWEN_OFFLOAD_DIR=artifacts/qwen_offload

# App
ARTIFACT_DIR=artifacts_portable
LOG_LEVEL=INFO
API_KEY=demo-key
LEGAL_API_URL=http://localhost:8000/v1/query

# DVC / remote
DVC_REMOTE_URL=../legal-rag-remote

# Monitoring
PROMETHEUS_ENABLED=false
OTEL_COLLECTOR_URL=

# Cloud provider credentials (use secrets in Streamlit / GitHub)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
HF_TOKEN=

# Backend (for Streamlit -> backend communication)
API_KEY=replace-with-strong-random-value
LEGAL_API_URL=http://localhost:8000/v1/query

# DVC remote (example: use GCS or S3 in production)
DVC_REMOTE_URL=gs://your-bucket/path-or-s3://your-bucket/path

# Optional MLflow and monitoring
MLFLOW_TRACKING_URI=
SENTRY_DSN=
LOGFLARE_SOURCE_TOKEN=
